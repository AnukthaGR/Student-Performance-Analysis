# =====================================================
# Force GitHub to recognize this as an R project
# =====================================================

# Completely exclude Jupyter notebooks
*.ipynb linguist-vendored=true

# Completely exclude all Python files
*.py linguist-vendored=true

# Exclude data files (don't count towards language %)
*.csv linguist-detectable=false
*.txt linguist-detectable=false
*.zip linguist-detectable=false
*.json linguist-detectable=false

# Explicitly force R files to be the primary language
*.R linguist-detectable=true linguist-language=R
*.r linguist-detectable=true linguist-language=R
